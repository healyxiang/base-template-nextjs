# 网站地址：本地使用 http://localhost:3000，上线后填写实际 HTTPS 域名（如 https://your-domain.com）。
# 用于 canonical、sitemap 和登录／支付回跳地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 项目 URL：从项目 API 设置中获取，例如 https://your-project.supabase.co。
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon 公钥：供浏览器鉴权使用，数据访问权限由数据库 RLS 控制。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role 私钥：仅服务端使用，用于额度、订单等受保护操作，不可添加 NEXT_PUBLIC 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# 管理员的 Supabase 用户 UUID：多个 ID 用英文逗号分隔；仅服务端使用，留空表示无人拥有管理权限。
ADMIN_USER_IDS=

# 在线支付开关：false 关闭，true 开启；先配置好 Waffo 商品及回调，再开启。
ONLINE_PAYMENT_ENABLED=false
# Waffo 支付环境：test 为测试环境，prod 为生产环境；商户、密钥、店铺和商品必须属于对应环境。
WAFFO_ENVIRONMENT=test
# Waffo 商户 ID：从 Waffo 商户后台获取。
WAFFO_MERCHANT_ID=
# Waffo 商户 PEM 私钥：仅服务端使用；换行可写成字面量 \n，建议将整个值用双引号包裹。
WAFFO_PRIVATE_KEY=
# Waffo 店铺 ID：用于校验 webhook 来源，防止其他店铺事件进入当前站点。
WAFFO_STORE_ID=
# 入门额度包的 Waffo 商品 ID：默认一次性支付 9 USD，获得 100 额度。
WAFFO_PRODUCT_STARTER=
# 成长额度包的 Waffo 商品 ID：默认一次性支付 19 USD，获得 250 额度。
WAFFO_PRODUCT_GROWTH=
# 进阶额度包的 Waffo 商品 ID：默认一次性支付 49 USD，获得 750 额度。
# 商品价格须与 src/config/site.ts 中的套餐一致；本版使用总价固定的 USD 商品。
WAFFO_PRODUCT_SCALE=

# 分析埋点开关：false 关闭，true 开启；还需下面的环境值为 production 才加载 GA4／Clarity。
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# 前端环境标识：本地填 development，预览填 preview，生产填 production。
# 这是模板使用的显式变量，部署到 Vercel 或其他平台时均需配置。
NEXT_PUBLIC_VERCEL_ENV=development
# GA4 衡量 ID：格式为 G-XXXXXXXXXX；留空不加载 GA4。
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity 项目 ID：从项目设置中获取；留空不加载 Clarity。
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console HTML 验证码：填写验证 meta 标签的 content 值，不填写整个标签。
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster HTML 验证码：填写 msvalidate.01 meta 标签的 content 值。
BING_SITE_VERIFICATION=
# IndexNow 验证密钥：自行生成 8～128 位字母、数字或连字符；站点自动提供 /<密钥>.txt。
# 部署后先执行 pnpm indexnow --dry-run 检查，再执行 pnpm indexnow 提交公开 URL。
INDEXNOW_KEY=

# Sentry 浏览器端 DSN：从 Sentry 项目设置中获取；留空不启用浏览器错误监控。
NEXT_PUBLIC_SENTRY_DSN=
# Sentry 服务端 DSN：可与浏览器端相同；留空时回退使用 NEXT_PUBLIC_SENTRY_DSN，两者均空则关闭。
SENTRY_DSN=
# Sentry 构建鉴权令牌：用于上传 source map；仅构建端使用，留空则不启用上传配置。
SENTRY_AUTH_TOKEN=
# Sentry 组织标识（slug）：配置 source map 上传时填写。
SENTRY_ORG=
# Sentry 项目标识（slug）：配置 source map 上传时填写。
SENTRY_PROJECT=
